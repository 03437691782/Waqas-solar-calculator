

name: Build Waqas Solar Calculator APK

on:
  workflow_dispatch:
  push:
    paths:
      - 'Waqas_Solar_Calculator_Android_Project_v1.3.zip'
      - '.github/workflows/android.yml'

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Set up Java
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Extract project ZIP
        run: |
          unzip -q Waqas_Solar_Calculator_Android_Project_v1.3.zip -d extracted

      - name: Set up Gradle
        uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: '8.9'

      - name: Build APK
        run: gradle -p extracted/WaqasSolarCalculator assembleDebug

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: Waqas-Solar-Calculator-APK
          path: extracted/WaqasSolarCalculator/app/build/outputs/apk/debug/app-debug.apk
